{
  "name": "intranet",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Brenner Corporative Portal",
  "author": "Natã Gabriel de Oliveira <191489149+Olliver-0@users.noreply.github.com>",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "nas:prod:deploy": "npm run nas:prod:build && npm run nas:prod:up",
    "nas:prod:deploy:web": "npm run nas:prod:build:web && npm run nas:prod:up:web",
    "nas:prod:deploy:api": "npm run nas:prod:build:api && npm run nas:prod:up:api",
    "nas:prod:up": "docker-compose -p intranet-prod -f docker-compose.yml --env-file .env.production up -d",
    "nas:prod:up:web": "docker-compose -p intranet-prod -f docker-compose.yml --env-file .env.production up -d --no-deps web",
    "nas:prod:up:api": "docker-compose -p intranet-prod -f docker-compose.yml --env-file .env.production up -d --no-deps api",
    "nas:prod:start": "sudo docker-compose -p intranet-prod -f docker-compose.yml --env-file .env.production start",
    "nas:prod:build": "docker-compose -p intranet-prod -f docker-compose.yml --env-file .env.production build --no-cache",
    "nas:prod:build:web": "docker-compose -p intranet-prod -f docker-compose.yml --env-file .env.production build --no-cache web",
    "nas:prod:build:api": "docker-compose -p intranet-prod -f docker-compose.yml --env-file .env.production build --no-cache api",
    "nas:prod:down": "docker-compose -p intranet-prod -f docker-compose.yml --env-file .env.production down",
    "nas:prod:stop": "sudo docker-compose -p intranet-prod -f docker-compose.yml --env-file .env.production stop",
    "nas:prod:migrate": "docker exec -u 0 -it intranet-api-prod npx prisma migrate deploy --schema=./apps/api/prisma/schema.prisma",
    "nas:prod:restart:api": "docker restart intranet-api-prod",
    "nas:prod:logs:api": "docker logs -f intranet-api-prod",
    "nas:prod:logs:db": "docker logs -f db-intranet-prod",
    "nas:prod:db:shell": "docker exec -it db-intranet-prod psql -U intranet_admin -d intranet_prod",
    "nas:prod:backup": "bash scripts/backup-nas-prod.sh",
    "nas:prod:restore": "sudo bash scripts/restore-nas-prod.sh",
    "nas:dev:deploy": "npm run nas:dev:build && npm run nas:dev:up",
    "nas:dev:deploy:web": "npm run nas:dev:build:web && npm run nas:dev:up:web",
    "nas:dev:deploy:api": "npm run nas:dev:build:api && npm run nas:dev:up:api",
    "nas:dev:up": "docker-compose -p intranet-dev -f docker-compose.dev.yml --env-file .env.staging up -d",
    "nas:dev:up:web": "docker-compose -p intranet-dev -f docker-compose.dev.yml --env-file .env.staging up -d --no-deps web",
    "nas:dev:up:api": "docker-compose -p intranet-dev -f docker-compose.dev.yml --env-file .env.staging up -d --no-deps api",
    "nas:dev:start": "sudo docker-compose -p intranet-dev -f docker-compose.dev.yml --env-file .env.staging start",
    "nas:dev:build": "docker-compose -p intranet-dev -f docker-compose.dev.yml --env-file .env.staging build --no-cache",
    "nas:dev:build:web": "docker-compose -p intranet-dev -f docker-compose.dev.yml --env-file .env.staging build --no-cache web",
    "nas:dev:build:api": "docker-compose -p intranet-dev -f docker-compose.dev.yml --env-file .env.staging build --no-cache api",
    "nas:dev:down": "docker-compose -p intranet-dev -f docker-compose.dev.yml --env-file .env.staging down",
    "nas:dev:stop": "sudo docker-compose -p intranet-dev -f docker-compose.dev.yml --env-file .env.staging stop",
    "nas:dev:migrate": "docker exec -u 0 -it intranet-api-dev npx prisma migrate deploy --schema=./apps/api/prisma/schema.prisma",
    "nas:dev:seed": "docker exec -u 0 -it intranet-api-dev npm run db:seed --workspace=api",
    "nas:dev:restart:api": "docker restart intranet-api-dev",
    "nas:dev:logs:api": "docker logs -f intranet-api-dev",
    "nas:dev:logs:db": "docker logs -f db-intranet-dev",
    "nas:dev:db:shell": "docker exec -it db-intranet-dev psql -U intranet_admin -d intranet_dev",
    "nas:dev:restore": "bash -c 'sudo docker exec -i db-intranet-dev psql -U intranet_admin -d intranet_dev -c \"DROP SCHEMA public CASCADE; CREATE SCHEMA public; GRANT ALL ON SCHEMA public TO intranet_admin; GRANT ALL ON SCHEMA public TO public;\" && sudo gzip -dc \"$0\" | sudo docker exec -i db-intranet-dev psql -U intranet_admin -d intranet_dev'",
    "db:shell": "docker exec -it db-intranet psql -U intranet_admin -d intranet_dev",
    "db:validate": "npm run prisma --workspace=api -- validate --schema=prisma/schema.prisma",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=api",
    "test:web": "npm run test --workspace=web",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:coverage:api": "npm run test:coverage --workspace=api",
    "test:coverage:web": "npm run test:coverage --workspace=web",
    "db:generate": "npm run prisma:generate --workspace=api",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7"
  }
}
