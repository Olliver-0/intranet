# Docker container name for the database service
DB_CONTAINER_NAME=db-intranet

# Host path where database data will be persisted
DB_VOLUME_PATH=./docker/postgres/data

# Credentials used to initialize the PostgreSQL container
POSTGRES_USER=intranet_admin
POSTGRES_PASSWORD=PASTE_PASSWORD_HERE
POSTGRES_DB=intranet_dev
DB_PORT=5433

# Credentials used to initialize the MinIO container
MINIO_ROOT_USER=intranet_admin
MINIO_ROOT_PASSWORD=PASTE_PASSWORD_HERE
MINIO_VOLUME_PATH=./docker/minio/data
MINIO_API_CORS_ALLOW_ORIGIN:https://localhost:5173
