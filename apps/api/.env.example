# =============================================================================
# DATABASE CONFIGURATION (PRISMA & APP)
# =============================================================================
# Main connection string. If you change POSTGRES_USER or DB_PORT, update this as well.
DATABASE_URL=postgresql://intranet_admin:PASTE_PASSWORD_HERE@localhost:5433/intranet_dev?schema=public

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# Temporary password for the 'admin' user created via 'npm run db:seed'
INITIAL_ADMIN_PASSWORD=PASTE_INITIAL_PASSWORD_HERE

# Secret key used to sign JWT tokens. Use a long, random string in production.
JWT_SECRET=PASTE_SECRET_HERE

# Bcrypt cost factor. Recommended: 10 for development.
BCRYPT_SALT_ROUNDS=10

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
PORT=3333
NODE_ENV=development

# MINIO CONFIGURATION
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=intranet_admin
MINIO_SECRET_KEY=PASTE_PASSWORD_HERE
MINIO_BUCKET_NAME=intranet-archives
MINIO_PUBLIC_URL=http://localhost:9000

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173
