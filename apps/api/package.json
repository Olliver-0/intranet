{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "db:migrate:local": "prisma migrate dev",
    "db:migrate:test": "dotenv -e .env.test -- prisma migrate dev",
    "db:deploy:staging": "dotenv -e .env.staging -- prisma migrate deploy",
    "db:deploy:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "db:seed": "tsx prisma/seed.mts",
    "db:studio:local": "prisma studio",
    "db:studio:staging": "dotenv -e .env.staging -- prisma studio",
    "db:studio:prod": "dotenv -e .env.production -- prisma studio",
    "lint": "eslint .",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "postinstall": "npm run prisma:generate",
    "format:check": "prettier --check \"**/*.ts\"",
    "prisma": "prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.2",
    "minio": "^8.0.7",
    "prisma": "^6.19.3",
    "sharp": "^0.35.3",
    "tsx": "^4.21.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.3.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.16"
  }
}
